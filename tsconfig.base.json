{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM"],
    "module": "ES2022",
    "moduleResolution": "Bundler",
    "resolveJsonModule": true,
    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "strict": true,
    "exactOptionalPropertyTypes": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedIndexedAccess": true,
    "skipLibCheck": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "baseUrl": ".",
    "paths": {
      "@repo/auth": ["packages/auth/src/index.ts"],
      "@repo/auth/server": ["packages/auth/src/auth.server.ts"],
      "@repo/auth/client": ["packages/auth/src/auth.client.ts"],
      "@repo/auth/permissions": ["packages/auth/src/auth.permissions.ts"],
      "@repo/auth/*": ["packages/auth/src/*"],
      "@repo/config/*": ["packages/config/*"],
      "@repo/db": ["packages/db/src/index.ts"],
      "@repo/db/*": ["packages/db/src/*"],
      "@repo/feature-flags": ["packages/feature-flags/src/index.ts"],
      "@repo/feature-flags/*": ["packages/feature-flags/src/*"],
      "@repo/logger": ["packages/logger/src/index.ts"],
      "@repo/logger/*": ["packages/logger/src/*"],
      "@repo/query": ["packages/query/src/index.ts"],
      "@repo/query/*": ["packages/query/src/*"],
      "@repo/storage": ["packages/storage/src/index.ts"],
      "@repo/storage/*": ["packages/storage/src/*"],
      "@repo/translation": ["packages/translation/src/index.ts"],
      "@repo/translation/*": ["packages/translation/src/*"],
      "@repo/ui": ["packages/ui/src/index.ts"],
      "@repo/ui/*": ["packages/ui/src/*"]
    }
  }
}
