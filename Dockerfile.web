# syntax=docker/dockerfile:1

# Digest-pinned so Trivy CRITICAL can be a hard gate (issue #155). Renovate bumps digests.
FROM node:22-slim@sha256:6c74791e557ce11fc957704f6d4fe134a7bc8d6f5ca4403205b2966bd488f6b3 AS base
ENV PNPM_HOME="/pnpm"
ENV PATH="$PNPM_HOME:$PATH"
RUN corepack enable && corepack prepare pnpm@10.29.3 --activate

FROM base AS pruner
WORKDIR /app
RUN pnpm add -g turbo@2
COPY . .
RUN turbo prune @repo/web --docker

FROM base AS builder
WORKDIR /app

ARG VITE_API_URL
ARG VITE_GRAPHQL_URL
ARG VITE_ORGANIZATIONS_VISIBLE

COPY --from=pruner /app/.npmrc ./
COPY --from=pruner /app/out/json/ ./
COPY --from=pruner /app/out/pnpm-lock.yaml ./pnpm-lock.yaml
RUN pnpm install --frozen-lockfile

COPY --from=pruner /app/out/full/ ./
COPY --from=pruner /app/tsconfig.base.json ./

RUN pnpm turbo run build --filter=@repo/web... \
  && test -f apps/web/dist/index.html

FROM nginxinc/nginx-unprivileged:alpine@sha256:18d67281256ded39ff65e010ae4f831be18f19356f83c60bc546492c7eb6dd23 AS runner

RUN rm /etc/nginx/conf.d/default.conf
COPY apps/web/nginx.conf /etc/nginx/default.conf.template
COPY --from=builder /app/apps/web/dist/ /usr/share/nginx/html/

ENV API_BACKEND_URL=http://localhost:4000

EXPOSE 3000
HEALTHCHECK --interval=30s --timeout=5s --retries=3 \
  CMD wget -q --spider http://127.0.0.1:3000/ || exit 1
CMD ["sh", "-c", "envsubst '$API_BACKEND_URL' < /etc/nginx/default.conf.template > /etc/nginx/conf.d/default.conf && exec nginx -g 'daemon off;'"]
