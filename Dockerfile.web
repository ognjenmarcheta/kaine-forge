# syntax=docker/dockerfile:1

# Digest-pinned so Trivy CRITICAL can be a hard gate (issue #155). Dependabot bumps the
# digest within the Node major; Node majors move with .nvmrc, engines, and CI (#323).
FROM node:22-slim@sha256:de170b39439eb0e5a3444ad7d60b015614a381e10fecae2e30ec9e735122f38d AS base
ENV PNPM_HOME="/pnpm"
ENV PATH="$PNPM_HOME:$PATH"
RUN corepack enable && corepack prepare pnpm@10.29.3 --activate

FROM base AS pruner
WORKDIR /app
RUN pnpm add -g turbo@2
COPY . .
RUN turbo prune @repo/web --docker

FROM base AS builder
WORKDIR /app

ARG VITE_API_URL
ARG VITE_GRAPHQL_URL

COPY --from=pruner /app/.npmrc ./
COPY --from=pruner /app/out/json/ ./
COPY --from=pruner /app/out/pnpm-lock.yaml ./pnpm-lock.yaml
RUN pnpm install --frozen-lockfile

COPY --from=pruner /app/out/full/ ./
COPY --from=pruner /app/tsconfig.base.json ./

RUN pnpm turbo run build --filter=@repo/web... \
  && test -f apps/web/dist/index.html

FROM nginxinc/nginx-unprivileged:alpine@sha256:b5047b9b76845eac124358373c6852377c52e4b05834a47647e955dd91cb8f1e AS runner

# Alpine security fixes land before the pinned nginx image is rebuilt (issue #491).
# CI passes the ISO week as APT_REFRESH, as for Dockerfile.api, so this layer reruns weekly.
ARG APT_REFRESH
USER root
RUN apk upgrade --no-cache
# The base image's unprivileged nginx user.
USER 101

RUN rm /etc/nginx/conf.d/default.conf
COPY apps/web/nginx.conf /etc/nginx/default.conf.template
COPY --from=builder /app/apps/web/dist/ /usr/share/nginx/html/

ENV API_BACKEND_URL=http://localhost:4000
# Content-Security-Policy origins (space-separated). The defaults fit the
# same-origin setup: the app calls /graphql and /api on its own origin, and
# storage is the docker-compose RustFS on localhost:9000.
# CSP_API_ORIGINS: API HTTP and WebSocket origins when VITE_API_URL points elsewhere.
ENV CSP_API_ORIGINS=""
# CSP_STORAGE_ORIGINS: S3 origins for presigned uploads and private-bucket thumbnails.
ENV CSP_STORAGE_ORIGINS=http://localhost:9000
# CSP_PUBLIC_ASSET_ORIGINS: the origin of S3_PUBLIC_BASE_URL.
ENV CSP_PUBLIC_ASSET_ORIGINS=http://localhost:9000
# CSP_BILLING_ORIGINS: Paddle.js and its checkout frames with BILLING_PROVIDER=paddle.
ENV CSP_BILLING_ORIGINS=""
# BILLING_PAYMENT_ORIGINS: double-quoted origins allowed wallet payments in a checkout frame.
ENV BILLING_PAYMENT_ORIGINS=""

EXPOSE 3000
HEALTHCHECK --interval=30s --timeout=5s --retries=3 \
  CMD wget -q --spider http://127.0.0.1:3000/ || exit 1
CMD ["sh", "-c", "envsubst '$API_BACKEND_URL $CSP_API_ORIGINS $CSP_STORAGE_ORIGINS $CSP_PUBLIC_ASSET_ORIGINS $CSP_BILLING_ORIGINS $BILLING_PAYMENT_ORIGINS' < /etc/nginx/default.conf.template > /etc/nginx/conf.d/default.conf && exec nginx -g 'daemon off;'"]
