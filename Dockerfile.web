# syntax=docker/dockerfile:1

# Digest-pinned so Trivy CRITICAL can be a hard gate (issue #155). Dependabot bumps the
# digest within the Node major; Node majors move with .nvmrc, engines, and CI (#323).
FROM node:22-slim@sha256:c3de60bf2f9dd0ac6370e6117950ff62d6e339527e7472301c9c78a017978392 AS base
ENV PNPM_HOME="/pnpm"
ENV PATH="$PNPM_HOME:$PATH"
RUN corepack enable && corepack prepare pnpm@10.29.3 --activate

FROM base AS pruner
WORKDIR /app
RUN pnpm add -g turbo@2
COPY . .
RUN turbo prune @repo/web --docker

FROM base AS builder
WORKDIR /app

ARG VITE_API_URL
ARG VITE_GRAPHQL_URL

COPY --from=pruner /app/.npmrc ./
COPY --from=pruner /app/out/json/ ./
COPY --from=pruner /app/out/pnpm-lock.yaml ./pnpm-lock.yaml
RUN pnpm install --frozen-lockfile

COPY --from=pruner /app/out/full/ ./
COPY --from=pruner /app/tsconfig.base.json ./

RUN pnpm turbo run build --filter=@repo/web... \
  && test -f apps/web/dist/index.html

FROM nginxinc/nginx-unprivileged:alpine@sha256:6a23acdfca2b9cfbcec61419e3f1426bcbedb91362f2f19306a8567423bb4612 AS runner

# Alpine security fixes land before the pinned nginx image is rebuilt (issue #491).
# CI passes the ISO week as APT_REFRESH, as for Dockerfile.api, so this layer reruns weekly.
ARG APT_REFRESH
USER root
RUN apk upgrade --no-cache
# The base image's unprivileged nginx user.
USER 101

RUN rm /etc/nginx/conf.d/default.conf
COPY apps/web/nginx.conf /etc/nginx/default.conf.template
COPY --from=builder /app/apps/web/dist/ /usr/share/nginx/html/

ENV API_BACKEND_URL=http://localhost:4000

EXPOSE 3000
HEALTHCHECK --interval=30s --timeout=5s --retries=3 \
  CMD wget -q --spider http://127.0.0.1:3000/ || exit 1
CMD ["sh", "-c", "envsubst '$API_BACKEND_URL' < /etc/nginx/default.conf.template > /etc/nginx/conf.d/default.conf && exec nginx -g 'daemon off;'"]
