# syntax=docker/dockerfile:1

# Digest-pinned so Trivy CRITICAL can be a hard gate (issue #155). Dependabot bumps the
# digest within the Node major; Node majors move with .nvmrc, engines, and CI (#323).
FROM node:22-slim@sha256:83f487e0a63425e5b4d146fb5e5be574bcbe1b7b843d3ebafdd95eaf7767a7e5 AS base
ENV PNPM_HOME="/pnpm"
ENV PATH="$PNPM_HOME:$PATH"
RUN corepack enable && corepack prepare pnpm@10.29.3 --activate

FROM base AS pruner
WORKDIR /app
RUN pnpm add -g turbo@2
COPY . .
RUN turbo prune @repo/api --docker

FROM base AS builder
WORKDIR /app

COPY --from=pruner /app/.npmrc ./
COPY --from=pruner /app/out/json/ ./
COPY --from=pruner /app/out/pnpm-lock.yaml ./pnpm-lock.yaml
RUN pnpm install --frozen-lockfile

COPY --from=pruner /app/out/full/ ./
COPY --from=pruner /app/tsconfig.base.json ./
COPY --from=pruner /app/scripts/fix-esm-extensions.mjs ./scripts/fix-esm-extensions.mjs

RUN pnpm turbo run build --filter=@repo/api... \
  && node scripts/fix-esm-extensions.mjs \
    apps/api/dist \
    packages/auth/dist \
    packages/db/dist \
    packages/email/dist \
    packages/feature-flags/dist \
    packages/logger/dist \
    packages/storage/dist \
    packages/translation/dist \
  && test -f apps/api/dist/index.js

FROM base AS runner
WORKDIR /app
ENV NODE_ENV=production

COPY --from=pruner /app/.npmrc ./
COPY --from=pruner /app/out/json/ ./
COPY --from=pruner /app/out/pnpm-lock.yaml ./pnpm-lock.yaml
RUN pnpm install --frozen-lockfile --prod --ignore-scripts

COPY --from=builder /app/apps/api/dist/ ./apps/api/dist/
COPY --from=builder /app/packages/auth/dist/ ./packages/auth/dist/
COPY --from=builder /app/packages/db/dist/ ./packages/db/dist/
COPY --from=builder /app/packages/db/drizzle/ ./packages/db/drizzle/
COPY --from=builder /app/packages/email/dist/ ./packages/email/dist/
COPY --from=builder /app/packages/feature-flags/dist/ ./packages/feature-flags/dist/
COPY --from=builder /app/packages/logger/dist/ ./packages/logger/dist/
COPY --from=builder /app/packages/storage/dist/ ./packages/storage/dist/
COPY --from=builder /app/packages/translation/dist/ ./packages/translation/dist/

# Runtime only needs `node` + app files. Drop install toolchains that ship
# nested vulnerable packages (base npm tar, corepack-cached pnpm's tar) so
# Trivy CRITICAL tracks app deps rather than the build toolchain.
RUN rm -rf \
  /usr/local/lib/node_modules/npm \
  /usr/local/bin/npm \
  /usr/local/bin/npx \
  /usr/local/bin/corepack \
  /root/.cache/node \
  /pnpm \
  "$PNPM_HOME"

USER node
EXPOSE 4000
HEALTHCHECK --interval=30s --timeout=5s --start-period=15s --retries=3 \
  CMD node -e "fetch('http://127.0.0.1:4000/health').then((r)=>process.exit(r.ok?0:1)).catch(()=>process.exit(1))"
CMD ["node", "apps/api/dist/index.js"]
