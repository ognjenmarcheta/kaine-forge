# syntax=docker/dockerfile:1

# Digest-pinned so Trivy CRITICAL can be a hard gate (issue #155). Dependabot bumps the
# digest within the Node major; Node majors move with .nvmrc, engines, and CI (#323).
FROM node:22-slim@sha256:5ec23b7c622b00547753bc6ffd78085dd868a68aeb41c8e0a1418f033e13d96d AS base
# Debian security fixes (e.g. perl-base) land before the pinned Node image is rebuilt.
# CI passes the ISO week as APT_REFRESH so the cached upgrade layer reruns weekly.
ARG APT_REFRESH
RUN apt-get update \
  && apt-get upgrade -y --no-install-recommends \
  && rm -rf /var/lib/apt/lists/*
ENV PNPM_HOME="/pnpm"
ENV PATH="$PNPM_HOME:$PATH"
RUN corepack enable && corepack prepare pnpm@10.29.3 --activate

FROM base AS pruner
WORKDIR /app
# Installs the turbo version pnpm-lock.yaml resolves for the root workspace, so turbo prune
# matches the repo's turbo and a lockfile bump needs no Dockerfile edit. The lockfile alone
# keys this layer. .ai/release-workflow.spec.ts runs this extraction against the lockfile.
COPY pnpm-lock.yaml ./
RUN turbo_version="$(awk '/^  \.:$/ { root = 1; next } root && /^  [^ ]/ { exit } root && /^      turbo:$/ { turbo = 1; next } turbo && /^        version:/ { print $2; exit }' pnpm-lock.yaml)" \
  && test -n "$turbo_version" \
  && pnpm add -g "turbo@$turbo_version"
COPY . .
RUN turbo prune @repo/api --docker

FROM base AS builder
WORKDIR /app

COPY --from=pruner /app/.npmrc ./
COPY --from=pruner /app/out/json/ ./
COPY --from=pruner /app/out/pnpm-lock.yaml ./pnpm-lock.yaml
RUN pnpm install --frozen-lockfile

COPY --from=pruner /app/out/full/ ./
COPY --from=pruner /app/tsconfig.base.json ./
COPY --from=pruner /app/scripts/fix-esm-extensions.mjs ./scripts/fix-esm-extensions.mjs

RUN pnpm turbo run build --filter=@repo/api... \
  && node scripts/fix-esm-extensions.mjs \
    apps/api/dist \
    packages/auth/dist \
    packages/billing/dist \
    packages/db/dist \
    packages/email/dist \
    packages/feature-flags/dist \
    packages/jobs/dist \
    packages/logger/dist \
    packages/storage/dist \
    packages/theme/dist \
    packages/translation/dist \
  && test -f apps/api/dist/index.js \
  && test -f apps/api/dist/worker.js

FROM base AS runner
WORKDIR /app
ENV NODE_ENV=production

COPY --from=pruner /app/.npmrc ./
COPY --from=pruner /app/out/json/ ./
COPY --from=pruner /app/out/pnpm-lock.yaml ./pnpm-lock.yaml
RUN pnpm install --frozen-lockfile --prod --ignore-scripts

COPY --from=builder /app/apps/api/dist/ ./apps/api/dist/
COPY --from=builder /app/packages/auth/dist/ ./packages/auth/dist/
COPY --from=builder /app/packages/billing/dist/ ./packages/billing/dist/
COPY --from=builder /app/packages/db/dist/ ./packages/db/dist/
COPY --from=builder /app/packages/db/drizzle/ ./packages/db/drizzle/
COPY --from=builder /app/packages/email/dist/ ./packages/email/dist/
COPY --from=builder /app/packages/feature-flags/dist/ ./packages/feature-flags/dist/
COPY --from=builder /app/packages/jobs/dist/ ./packages/jobs/dist/
COPY --from=builder /app/packages/logger/dist/ ./packages/logger/dist/
COPY --from=builder /app/packages/storage/dist/ ./packages/storage/dist/
COPY --from=builder /app/packages/theme/dist/ ./packages/theme/dist/
COPY --from=builder /app/packages/translation/dist/ ./packages/translation/dist/

# A workspace package the API imports but this image lacks would crash every
# container at start, while the old container keeps serving. Fail the build instead.
COPY --from=pruner /app/scripts/check-image-packages.mjs ./scripts/check-image-packages.mjs
RUN node scripts/check-image-packages.mjs apps/api

# Runtime only needs `node` + app files. Drop install toolchains that ship
# nested vulnerable packages (base npm tar, corepack-cached pnpm's tar) so
# Trivy CRITICAL tracks app deps rather than the build toolchain.
RUN rm -rf \
  /usr/local/lib/node_modules/npm \
  /usr/local/bin/npm \
  /usr/local/bin/npx \
  /usr/local/bin/corepack \
  /root/.cache/node \
  /pnpm \
  "$PNPM_HOME"

USER node
EXPOSE 4000
HEALTHCHECK --interval=30s --timeout=5s --start-period=15s --retries=3 \
  CMD node -e "fetch('http://127.0.0.1:4000/health').then((r)=>process.exit(r.ok?0:1)).catch(()=>process.exit(1))"
# The job worker runs from this same image: override the command with
# `node apps/api/dist/worker.js` and set JOBS_RUNNER_ENABLED=false on the API (ADR 0018).
CMD ["node", "apps/api/dist/index.js"]
