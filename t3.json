{
  "$schema": "https://t3.codes/schema/t3.json",
  "scripts": [
    {
      "name": "Setup worktree",
      "command": "node scripts/t3-worktree-setup.mjs",
      "icon": "configure",
      "runOnWorktreeCreate": true,
      "async": false
    },
    {
      "name": "Dev",
      "command": "pnpm dev",
      "icon": "play",
      "stopOnSettle": true
    },
    {
      "name": "Check affected",
      "command": "pnpm check:affected",
      "icon": "test"
    }
  ]
}
