#!/usr/bin/env sh
set -e
# GitButler's `but commit` skips commit-msg, so lint every pushed commit here too.
# Lint only the commits that main does not have yet: commits on main passed the PR gate,
# and a merge from main, or the release/<app> push of main's HEAD, must not fail on them.
while read -r _ LOCAL_SHA _ REMOTE_SHA; do
  case "$LOCAL_SHA" in *[!0]*) ;; *) continue ;; esac
  # A stale refs/remotes/<remote>/main gives an older merge-base, so refresh it first
  # (offline, the local ref stands). The remote tip is the narrower base when it already
  # holds everything up to that merge-base.
  git fetch -q "$1" main 2>/dev/null || true
  FROM="$(git merge-base "$LOCAL_SHA" "refs/remotes/$1/main" 2>/dev/null || true)"
  case "$REMOTE_SHA" in
    *[!0]*)
      if git cat-file -e "$REMOTE_SHA" 2>/dev/null; then
        if [ -z "$FROM" ] || git merge-base --is-ancestor "$FROM" "$REMOTE_SHA" 2>/dev/null; then
          FROM="$REMOTE_SHA"
        fi
      fi ;;
  esac
  if [ -z "$FROM" ]; then PUSHED_FULL=1; continue; fi
  # An equal range is a commitlint usage error (exit 9); main's own HEAD has nothing to lint.
  if [ "$FROM" != "$LOCAL_SHA" ]; then
    pnpm exec commitlint --from "$FROM" --to "$LOCAL_SHA" </dev/null
    node scripts/check-public-text.mjs --from "$FROM" --to "$LOCAL_SHA" </dev/null
  fi
  # The oldest base across pushed refs scopes the typecheck when HEAD has no upstream.
  PUSHED_BASE="$(git merge-base "${PUSHED_BASE:-$FROM}" "$FROM" 2>/dev/null || true)"
  [ -n "$PUSHED_BASE" ] || PUSHED_FULL=1
done
pnpm ai:doctor -- --strict
# Typecheck only packages changed since the remote tip (falls back to full typecheck).
BASE=""
if git rev-parse --abbrev-ref --symbolic-full-name @{u} >/dev/null 2>&1; then
  BASE="$(git merge-base HEAD @{u} 2>/dev/null || true)"
elif [ -z "$PUSHED_FULL" ]; then
  BASE="$PUSHED_BASE"
fi
if [ -n "$BASE" ] && [ "$BASE" != "$(git rev-parse HEAD)" ]; then
  pnpm exec turbo run typecheck --filter="...[${BASE}]" --continue
  exit 0
fi
pnpm typecheck
