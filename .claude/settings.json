{
  "permissions": {
    "ask": [
      "Bash(pnpm db:seed)",
      "Bash(pnpm db:seed *)",
      "Bash(pnpm db:migrate)",
      "Bash(pnpm db:migrate *)",
      "Bash(pnpm reinstall-deps)",
      "Bash(pnpm reinstall-deps *)",
      "Bash(git reset --hard)",
      "Bash(git reset --hard *)"
    ],
    "deny": [
      "Bash(pnpm db:push)",
      "Bash(pnpm db:push *)",
      "Bash(pnpm clean-deps)",
      "Bash(pnpm clean-deps *)",
      "Bash(pnpm release:apps)",
      "Bash(pnpm release:apps *)",
      "Bash(gh pr merge)",
      "Bash(gh pr merge *)",
      "Bash(but land)",
      "Bash(but land *)",
      "Bash(but pr auto-merge)",
      "Bash(but pr auto-merge *)"
    ],
    "allow": [
      "mcp__context7__resolve-library-id",
      "mcp__context7__query-docs",
      "mcp__gitbutler__gitbutler_workspace",
      "mcp__gitbutler__gitbutler_branch_details",
      "mcp__gitbutler__gitbutler_commit_details",
      "mcp__gitbutler__gitbutler_review_card",
      "mcp__gitbutler__gitbutler_refresh_reviews",
      "mcp__serena__initial_instructions",
      "mcp__serena__find_symbol",
      "mcp__serena__find_referencing_symbols",
      "mcp__serena__get_symbols_overview",
      "mcp__serena__search_for_pattern",
      "mcp__serena__list_dir",
      "mcp__serena__find_file",
      "mcp__serena__find_declaration",
      "mcp__serena__find_implementations",
      "mcp__serena__get_diagnostics_for_file",
      "mcp__serena__list_memories",
      "mcp__serena__read_memory",
      "mcp__serena__get_current_config"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "^(Bash|PowerShell)$",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$(git rev-parse --show-toplevel)/.ai/hooks/pre-tool-use.mjs\" --agent claude",
            "timeout": 10
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "startup|resume",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$(git rev-parse --show-toplevel)/.ai/hooks/session-start.mjs\" --agent claude",
            "statusMessage": "Loading Kaine Forge AI context"
          }
        ]
      }
    ]
  }
}
