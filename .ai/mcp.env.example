# Copy this file to .ai.local/mcp.env and fill in your personal values.
# .ai.local/ is gitignored. Do not commit real secrets.
#
# `pnpm ai:install` reads this file and substitutes the values into the generated
# per-tool MCP configs (.mcp.json, .codex/config.toml, .cursor/mcp.json,
# opencode.json). Those configs are gitignored and local to your machine.
#
# To add personal MCP servers, create `.ai.local/mcp.json` next to this file.
# See `.ai/mcp.json.example` for the format. Team entries in `.ai/mcp.json`
# win on name collisions.
#
# If a required value is empty, the affected MCP and any skill that requires
# it are skipped at install time.

# Firecrawl (optional, opt-in MCP). Sign up at https://firecrawl.dev for an API key.
# Install with: pnpm ai:install --mcp firecrawl
FIRECRAWL_API_KEY=
