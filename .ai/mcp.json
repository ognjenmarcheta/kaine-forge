{
  "mcpServers": {
    "filesystem": {
      "command": "npx",
      "args": ["--prefix=.ai", "-y", "@modelcontextprotocol/server-filesystem@2026.8.31", "."],
      "default": false
    },
    "context7": {
      "command": "npx",
      "args": ["--prefix=.ai", "-y", "@upstash/context7-mcp@4.1.1"]
    },
    "better-auth": {
      "url": "https://mcp.better-auth.com/mcp"
    },
    "playwright": {
      "command": "npx",
      "args": [
        "--prefix=.ai",
        "-y",
        "@playwright/mcp@0.0.82",
        "--headless",
        "--isolated",
        "--output-dir=.ai.local/playwright"
      ]
    },
    "serena": {
      "command": "uvx",
      "args": [
        "--from",
        "serena-agent==2.1.0",
        "serena",
        "start-mcp-server",
        "--project-from-cwd",
        "--context",
        "ide",
        "--agent-interface",
        "tools",
        "--open-web-dashboard",
        "False",
        "--mode",
        "editing",
        "--mode",
        "interactive"
      ],
      "env": {
        "SERENA_USAGE_REPORTING": "false"
      }
    },
    "chrome-devtools": {
      "command": "npx",
      "args": [
        "--prefix=.ai",
        "-y",
        "chrome-devtools-mcp@1.10.1",
        "--headless",
        "--isolated",
        "--no-usage-statistics",
        "--no-performance-crux"
      ],
      "default": false
    },
    "firecrawl": {
      "command": "npx",
      "args": ["--prefix=.ai", "-y", "firecrawl-mcp@3.25.5"],
      "default": false,
      "env": {
        "FIRECRAWL_API_KEY": "${FIRECRAWL_API_KEY}"
      }
    },
    "graphify": {
      "command": "graphify-mcp",
      "args": ["graphify-out/graph.json"],
      "default": false
    },
    "gitbutler": {
      "command": "but",
      "args": ["mcp", "serve"],
      "default": false
    }
  }
}
