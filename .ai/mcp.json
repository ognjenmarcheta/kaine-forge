{
  "mcpServers": {
    "filesystem": {
      "command": "npx",
      "args": ["-y", "@modelcontextprotocol/server-filesystem@2026.8.31", "."]
    },
    "context7": {
      "command": "npx",
      "args": ["-y", "@upstash/context7-mcp@4.1.1"]
    },
    "playwright": {
      "command": "npx",
      "args": ["-y", "@playwright/mcp@0.0.82"]
    },
    "serena": {
      "command": "uvx",
      "args": [
        "--from",
        "serena-agent==2.0.0",
        "serena",
        "start-mcp-server",
        "--project-from-cwd",
        "--context",
        "ide",
        "--agent-interface",
        "tools",
        "--open-web-dashboard",
        "False",
        "--mode",
        "editing",
        "--mode",
        "interactive"
      ],
      "env": {
        "SERENA_USAGE_REPORTING": "false"
      }
    },
    "firecrawl": {
      "command": "npx",
      "args": ["-y", "firecrawl-mcp@3.25.5"],
      "default": false,
      "env": {
        "FIRECRAWL_API_KEY": "${FIRECRAWL_API_KEY}"
      }
    },
    "graphify": {
      "command": "graphify-mcp",
      "args": ["graphify-out/graph.json"],
      "default": false
    }
  }
}
