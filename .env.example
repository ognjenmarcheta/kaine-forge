# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/monorepo_dev

# Auth
BETTER_AUTH_SECRET=your-secret-key-change-in-production
BETTER_AUTH_URL=http://localhost:4000
EMAIL_PROVIDER=console
AUTH_REQUIRE_EMAIL_VERIFICATION=false

# API
API_HOST=127.0.0.1
API_PORT=4000
API_URL=http://localhost:4000
API_RUN_MIGRATIONS=false
API_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
API_GRAPHQL_MAX_DEPTH=8
ORGANIZATIONS_VISIBLE=true
AI_TODO_PROVIDER=openai
AI_TODO_MODEL=
OPENAI_API_KEY=
DEEPSEEK_API_KEY=

# Logging
LOG_LEVEL=info

# Web
VITE_API_PROXY_TARGET=http://localhost:4000
VITE_API_URL=http://localhost:4000
VITE_GRAPHQL_URL=http://localhost:4000/graphql
VITE_ORGANIZATIONS_VISIBLE=true

# Mobile
EXPO_PUBLIC_API_URL=http://localhost:4000
EXPO_PUBLIC_GRAPHQL_URL=http://localhost:4000/graphql
EXPO_PUBLIC_ORGANIZATIONS_VISIBLE=true

# Storage (S3-compatible; works with AWS S3, MinIO, R2, Wasabi, B2, Hetzner)
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=kaine-forge-dev
S3_FORCE_PATH_STYLE=true
S3_PRESIGNED_URL_EXPIRY=3600
