# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/monorepo_dev

# Auth
BETTER_AUTH_SECRET=your-secret-key-change-in-production
BETTER_AUTH_URL=http://localhost:4000
EMAIL_PROVIDER=console
# EMAIL_PROVIDER=resend
# RESEND_API_KEY=
# EMAIL_FROM=noreply@example.com
AUTH_REQUIRE_EMAIL_VERIFICATION=false
# Social login (optional; each provider activates only when both vars are set)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# API
API_HOST=127.0.0.1
API_PORT=4000
API_URL=http://localhost:4000
API_RUN_MIGRATIONS=false
API_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
API_GRAPHQL_MAX_DEPTH=8
API_RATE_LIMIT_ENABLED=true
API_RATE_LIMIT_MAX=100
API_RATE_LIMIT_WINDOW_MS=60000
# Set true only when the API sits behind a trusted reverse proxy that appends x-forwarded-for
API_TRUST_PROXY=false
ORGANIZATIONS_VISIBLE=true
AI_TODO_PROVIDER=openai
AI_TODO_MODEL=
OPENAI_API_KEY=
DEEPSEEK_API_KEY=

# Logging
LOG_LEVEL=info

# Web
VITE_API_PROXY_TARGET=http://localhost:4000
VITE_API_URL=http://localhost:4000
VITE_GRAPHQL_URL=http://localhost:4000/graphql
VITE_ORGANIZATIONS_VISIBLE=true
# Social login buttons shown in the web UI (comma-separated: github,google); server provider vars above stay authoritative
VITE_AUTH_SOCIAL_PROVIDERS=

# Mobile
EXPO_PUBLIC_API_URL=http://localhost:4000
EXPO_PUBLIC_GRAPHQL_URL=http://localhost:4000/graphql
EXPO_PUBLIC_ORGANIZATIONS_VISIBLE=true
# Reserved for mobile social login buttons; the mobile UI ships without them until native deep-link handling is added
# Comma-separated UI gate for mobile social buttons (github,google). Server
# GITHUB_*/GOOGLE_* env vars remain authoritative for which providers work.
# Requires deep-link scheme kaineforge:// (apps/mobile app.json) trusted on API.
EXPO_PUBLIC_AUTH_SOCIAL_PROVIDERS=

# Storage (S3-compatible; works with AWS S3, MinIO, R2, Wasabi, B2, Hetzner)
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=kaine-forge-dev
S3_FORCE_PATH_STYLE=true
S3_PRESIGNED_URL_EXPIRY=3600
