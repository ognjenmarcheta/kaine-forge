# Database
# Explicit opt-in for db:push:local / db:prepare:local; never enable on shared databases.
ALLOW_LOCAL_DB_PUSH=false
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/monorepo_dev

# Auth
BETTER_AUTH_SECRET=your-secret-key-change-in-production
BETTER_AUTH_URL=http://localhost:4000
EMAIL_PROVIDER=console
# EMAIL_PROVIDER=resend
# RESEND_API_KEY=
# EMAIL_FROM=noreply@example.com
AUTH_REQUIRE_EMAIL_VERIFICATION=false
# Reject passwords found in Have I Been Pwned on sign-up, change, and reset.
# Needs api.pwnedpasswords.com; set false for offline development (ADR 0015).
AUTH_PASSWORD_BREACH_CHECK=true
# Captcha (Cloudflare Turnstile). Off while TURNSTILE_SECRET_KEY is blank.
# Cloudflare test keys that always pass: secret 1x0000000000000000000000000000000AA,
# site key 1x00000000000000000000AA (set VITE_/EXPO_PUBLIC_TURNSTILE_SITE_KEY below).
TURNSTILE_SECRET_KEY=
# Optional comma-separated hostnames a token must be issued for (e.g. app.example.com)
TURNSTILE_ALLOWED_HOSTNAMES=
# Social login (optional; each provider activates only when both vars are set)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Google OAuth client (Web application). Authorized redirect URI:
# ${BETTER_AUTH_URL}/api/auth/callback/google, e.g. http://localhost:4000/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# API
API_HOST=127.0.0.1
API_PORT=4000
API_URL=http://localhost:4000
API_RUN_MIGRATIONS=false
API_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
API_GRAPHQL_MAX_DEPTH=8
# GraphQL field-selection complexity cap (default 200)
# API_GRAPHQL_MAX_COMPLEXITY=200
# true or false forces GraphQL introspection; unset means on in development, off in production
# API_GRAPHQL_INTROSPECTION=
API_RATE_LIMIT_ENABLED=true
API_RATE_LIMIT_MAX=100
API_RATE_LIMIT_WINDOW_MS=60000
# Set true only when the API sits behind a trusted reverse proxy that appends x-forwarded-for
API_TRUST_PROXY=false
AI_TODO_PROVIDER=openai
AI_TODO_MODEL=
# Falls back to AI_TODO_* when unset. Must be exactly openai or deepseek.
AI_ASSISTANT_PROVIDER=
AI_ASSISTANT_MODEL=
OPENAI_API_KEY=
DEEPSEEK_API_KEY=

# Logging
LOG_LEVEL=info
# Optional error-reporting seam: a no-op unless enabled, or a DSN is set in production
# OBSERVABILITY_ENABLED=false
# SENTRY_DSN=
# OTEL_EXPORTER_OTLP_ENDPOINT=

# Web
VITE_API_PROXY_TARGET=http://localhost:4000
VITE_API_URL=http://localhost:4000
VITE_GRAPHQL_URL=http://localhost:4000/graphql
# Social login buttons shown in the web UI (comma-separated: github,google); server provider vars above stay authoritative
VITE_AUTH_SOCIAL_PROVIDERS=
# Turnstile site key; the web forms render the captcha only when it is set
VITE_TURNSTILE_SITE_KEY=

# Mobile
EXPO_PUBLIC_API_URL=http://localhost:4000
EXPO_PUBLIC_GRAPHQL_URL=http://localhost:4000/graphql
# Reserved for mobile social login buttons; the mobile UI ships without them until native deep-link handling is added
# Comma-separated UI gate for mobile social buttons (github,google). Server
# GITHUB_*/GOOGLE_* env vars remain authoritative for which providers work.
# Requires deep-link scheme kaineforge:// (apps/mobile app.json) trusted on API.
EXPO_PUBLIC_AUTH_SOCIAL_PROVIDERS=
# Turnstile site key for the mobile captcha WebView; the base URL must use a
# hostname allowed for that site key (any https URL works with the test key).
EXPO_PUBLIC_TURNSTILE_SITE_KEY=
EXPO_PUBLIC_TURNSTILE_BASE_URL=

# Storage (S3-compatible; works with AWS S3, MinIO, R2, Wasabi, B2, Hetzner)
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=kaine-forge-dev
S3_FORCE_PATH_STYLE=true
# Presigned URL lifetimes in seconds (S3_PRESIGNED_URL_EXPIRY is the fallback for both).
S3_UPLOAD_URL_EXPIRY=600
S3_DOWNLOAD_URL_EXPIRY=300
# The API deletes objects of deleted and abandoned Attachments on this interval (on when S3 is set).
# STORAGE_SWEEP_ENABLED=false
# STORAGE_SWEEP_INTERVAL_MS=900000
