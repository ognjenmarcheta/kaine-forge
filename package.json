{
  "name": "kaine-forge",
  "private": true,
  "packageManager": "pnpm@10.29.3",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "turbo run dev --concurrency=20 --continue=always",
    "build": "turbo run build",
    "build:core": "turbo run build --filter=@repo/api --filter=@repo/web",
    "check": "pnpm run format:check && pnpm run lint && pnpm run typecheck && pnpm run test",
    "check:ci": "pnpm run format:check && pnpm run lint && pnpm run typecheck && pnpm run test",
    "format": "turbo run format --continue",
    "format:check": "turbo run format:check --continue",
    "lint": "turbo run lint --continue",
    "lint:fix": "turbo run lint:fix --continue",
    "typecheck": "turbo run typecheck --continue",
    "test": "turbo run test --continue",
    "test:e2e": "pnpm run db:ensure && pnpm run db:push && pnpm run db:seed && pnpm --filter @repo/e2e run test:e2e",
    "release:status": "changeset status --verbose",
    "release:version": "changeset version",
    "release:publish": "changeset tag",
    "clean": "turbo run clean --continue",
    "clean-deps": "find . -name node_modules -type d -prune -exec rm -rf {} +",
    "reinstall-deps": "pnpm run clean-deps && pnpm install",
    "initialize": "pnpm run reinstall-deps && pnpm run build && pnpm run db:generate && pnpm run db:push && pnpm run db:seed && pnpm run dev",
    "generate": "pnpm --filter @repo/graphql-codegen run generate",
    "db:generate": "pnpm --filter @repo/db run db:generate",
    "db:ensure": "pnpm --filter @repo/db run db:ensure",
    "db:push": "pnpm --filter @repo/db run db:push",
    "db:migrate": "pnpm --filter @repo/db run db:migrate",
    "db:seed": "pnpm --filter @repo/db run db:seed",
    "db:studio": "pnpm --filter @repo/db run db:studio",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{js,mjs,cjs,ts,tsx,json,md,css,yml,yaml}": [
      "prettier --write"
    ],
    "*.{js,mjs,cjs,ts,tsx}": [
      "eslint --fix"
    ]
  },
  "devDependencies": {
    "@changesets/cli": "^2.29.8",
    "@eslint/js": "^9.35.0",
    "@types/node": "^24.3.0",
    "eslint": "^9.35.0",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "globals": "^16.4.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.1.6",
    "prettier": "^3.7.4",
    "tsx": "^4.20.5",
    "turbo": "^2.8.10",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.43.0",
    "vitest": "^3.2.4"
  }
}
