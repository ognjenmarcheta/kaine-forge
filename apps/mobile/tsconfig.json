{
  "extends": "../../packages/config/typescript/tsconfig.native.json",
  "compilerOptions": {
    "allowJs": true,
    "jsx": "react-jsx",
    "types": ["react", "react-native"]
  },
  "include": [
    "app/**/*.ts",
    "app/**/*.tsx",
    "src/**/*.ts",
    "src/**/*.tsx",
    "expo-env.d.ts",
    "nativewind-env.d.ts",
    ".expo/types/**/*.ts"
  ],
  "exclude": ["src/graphql/generated/**/*"]
}
