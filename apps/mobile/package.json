    "expo-web-browser": "^15.0.11",
    "graphql": "catalog:",
    "graphql-request": "catalog:",
    "graphql-ws": "catalog:",
    "nativewind": "catalog:mobile",
    "react": "catalog:mobile",
    "react-native": "catalog:mobile",
    "react-native-css-interop": "catalog:mobile",
    "react-native-gesture-handler": "^2.28.0",
    "react-native-reanimated": "catalog:mobile",
