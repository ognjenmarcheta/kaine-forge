{
  "name": "@repo/mobile",
  "version": "1.4.0",
  "private": true,
  "main": "expo-router/entry",
  "type": "module",
  "scripts": {
    "dev": "expo start",
    "dev:ios": "expo start --ios",
    "dev:android": "expo start --android",
    "build": "tsc --noEmit",
    "start": "expo start",
    "check": "pnpm run format:check && pnpm run lint && pnpm run typecheck && pnpm run test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "test:watch": "vitest --passWithNoTests",
    "clean": "rm -rf dist .turbo .expo"
  },
  "dependencies": {
    "@better-auth/expo": "catalog:",
    "@graphql-typed-document-node/core": "catalog:",
    "@react-native-async-storage/async-storage": "^2.2.0",
    "@react-navigation/drawer": "^7.5.0",
    "@repo/auth": "workspace:*",
    "@repo/feature-flags": "workspace:*",
    "@repo/logger": "workspace:*",
    "@repo/mobile-ui": "workspace:*",
    "@repo/persistence": "workspace:*",
    "@repo/query": "workspace:*",
    "@repo/storage": "workspace:*",
    "@repo/todos": "workspace:*",
    "@repo/translation": "workspace:*",
    "@tanstack/react-query": "catalog:",
    "expo": "~54.0.34",
    "expo-constants": "^18.0.13",
    "expo-document-picker": "~14.0.8",
    "expo-linking": "^8.0.12",
    "expo-network": "^8.0.8",
    "expo-router": "^6.0.23",
    "expo-secure-store": "^15.0.8",
