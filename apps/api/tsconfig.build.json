{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "composite": true,
    "rootDir": "src",
    "outDir": "dist",
    "paths": {},
    "tsBuildInfoFile": "${configDir}/dist/.tsbuildinfo"
  },
  "exclude": [
    "src/**/*.eval.*",
    "src/**/*.test.ts",
    "src/**/*.test.tsx",
    "src/**/*.spec.ts",
    "src/**/*.spec.tsx",
    "src/**/*test-helpers*.ts"
  ],
  "references": [
    {
      "path": "../../packages/auth/tsconfig.build.json"
    },
    {
      "path": "../../packages/db/tsconfig.build.json"
    },
    {
      "path": "../../packages/feature-flags/tsconfig.build.json"
    },
    {
      "path": "../../packages/logger/tsconfig.build.json"
    },
    {
      "path": "../../packages/storage/tsconfig.build.json"
    },
    {
      "path": "../../packages/translation/tsconfig.build.json"
    }
  ]
}
