{
  "name": "@repo/auth",
  "version": "1.4.2",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./auth.definition": {
      "types": "./dist/auth.definition.d.ts",
      "default": "./dist/auth.definition.js"
    },
    "./auth.type": {
      "types": "./dist/auth.type.d.ts",
      "default": "./dist/auth.type.js"
    },
    "./auth.util": {
      "types": "./dist/auth.util.d.ts",
      "default": "./dist/auth.util.js"
    },
    "./form": {
      "types": "./dist/auth.form.d.ts",
      "default": "./dist/auth.form.js"
    },
    "./password": {
      "types": "./dist/auth.password.d.ts",
      "default": "./dist/auth.password.js"
    },
    "./instance": {
      "types": "./dist/auth.instance.d.ts",
      "default": "./dist/auth.instance.js"
    },
    "./scope": {
      "types": "./dist/auth.scope.d.ts",
      "default": "./dist/auth.scope.js"
    },
    "./server": {
      "types": "./dist/auth.server.d.ts",
      "default": "./dist/auth.server.js"
    },
    "./session": {
      "types": "./dist/auth.session.d.ts",
      "default": "./dist/auth.session.js"
    },
    "./client": {
      "types": "./dist/auth.client.d.ts",
      "default": "./dist/auth.client.js"
    },
    "./transport": {
      "types": "./dist/auth.transport.d.ts",
      "default": "./dist/auth.transport.js"
    },
    "./permissions": {
      "types": "./dist/auth.permissions.d.ts",
      "default": "./dist/auth.permissions.js"
    }
  },
  "scripts": {
    "dev": "echo \"@repo/auth has no dev runtime\"",
    "build": "tsc -b tsconfig.build.json",
    "check": "pnpm run format:check && pnpm run lint && pnpm run typecheck && pnpm run test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "test:watch": "vitest --passWithNoTests",
    "clean": "rm -rf dist .turbo"
  },
  "dependencies": {
    "@better-auth/expo": "catalog:",
    "@repo/db": "workspace:*",
    "@repo/email": "workspace:*",
    "better-auth": "catalog:",
    "drizzle-orm": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@repo/config": "workspace:*",
    "vitest": "catalog:"
  }
}
