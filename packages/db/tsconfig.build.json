{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "composite": true,
    "rootDir": "src",
    "outDir": "dist",
    "paths": {},
    "tsBuildInfoFile": "${configDir}/dist/.tsbuildinfo"
  },
  "exclude": [
    "src/**/*.test.ts",
    "src/**/*.test.tsx",
    "src/**/*.spec.ts",
    "src/**/*.spec.tsx",
    "src/**/*test-helpers*.ts",
    "src/seed/**"
  ],
  "references": [
    {
      "path": "../logger/tsconfig.build.json"
    }
  ]
}
