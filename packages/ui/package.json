{
  "name": "@repo/ui",
  "version": "1.1.0",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./primitives/sheet": {
      "types": "./dist/components/primitives/sheet.d.ts",
      "default": "./dist/components/primitives/sheet.js"
    },
    "./primitives/sidebar": {
      "types": "./dist/components/primitives/sidebar.d.ts",
      "default": "./dist/components/primitives/sidebar.js"
    },
    "./styles/globals.css": "./src/styles/globals.css"
  },
  "sideEffects": [
    "./src/styles/globals.css"
  ],
  "files": [
    "dist",
    "src/styles/globals.css"
  ],
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "check": "pnpm run format:check && pnpm run lint && pnpm run typecheck && pnpm run test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "test:watch": "vitest --passWithNoTests",
    "clean": "rm -rf dist .turbo"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-slot": "^1.2.4",
    "@tanstack/react-form": "^1.28.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.575.0",
    "radix-ui": "^1.4.3",
    "react": "^19.1.1",
    "tailwind-merge": "^3.3.1"
  },
  "devDependencies": {
    "@types/react": "^19.1.10",
    "@types/react-dom": "^19.1.7",
    "react-dom": "^19.1.1",
    "tailwindcss": "^4.2.0"
  }
}
