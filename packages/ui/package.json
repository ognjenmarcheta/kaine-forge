{
  "name": "@repo/ui",
  "version": "1.2.1",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./primitives/sheet": {
      "types": "./dist/components/primitives/sheet.d.ts",
      "default": "./dist/components/primitives/sheet.js"
    },
    "./primitives/sidebar": {
      "types": "./dist/components/primitives/sidebar.d.ts",
      "default": "./dist/components/primitives/sidebar.js"
    },
    "./styles/globals.css": "./src/styles/globals.css"
  },
  "sideEffects": [
    "./src/styles/globals.css"
  ],
  "files": [
    "dist",
    "src/styles/globals.css"
  ],
  "scripts": {
    "dev": "echo \"@repo/ui has no dev runtime\"",
    "build": "tsc -b tsconfig.build.json",
    "check": "pnpm run format:check && pnpm run lint && pnpm run typecheck && pnpm run test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "test:watch": "vitest --passWithNoTests",
    "clean": "rm -rf dist .turbo"
  },
  "dependencies": {
    "@tanstack/react-form": "^1.33.2",
    "class-variance-authority": "catalog:",
    "clsx": "catalog:",
    "lucide-react": "^0.577.0",
    "radix-ui": "^1.6.7",
    "react": "catalog:",
    "sonner": "catalog:",
    "tailwind-merge": "catalog:"
  },
  "devDependencies": {
    "@repo/config": "workspace:*",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "react-dom": "catalog:",
    "tailwindcss": "catalog:",
    "vitest": "catalog:"
  }
}
